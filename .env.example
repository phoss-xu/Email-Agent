# IMAP 邮箱配置
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_password_here
IMAP_SERVER=imap.qiye.aliyun.com
IMAP_PORT=993

# 钉钉群机器人 Webhook
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token_here

# 实时检测间隔（分钟）
CHECK_INTERVAL=3

# 日报推送时间（24小时制）
DAILY_REPORT_HOUR=9
DAILY_REPORT_MINUTE=0

# 图片上传配置（日报图片托管，默认使用 sm.ms 免费图床）
# IMAGE_UPLOAD_URL=https://sm.ms/api/v2/upload
# IMAGE_UPLOAD_TOKEN=your_smms_token_here

# R2 存储配置（日报 HTML/图片托管：钉钉内嵌图片 + 完整版链接）
# 凭证：Cloudflare 控制台 → My Profile → API Tokens → 创建 R2 令牌（Object Read & Write: Edit）
# 公网地址：R2 → 你的 bucket → Settings → Public Access → Allow Access 后获得 https://pub-xxxxx.r2.dev
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_API_TOKEN=your_cloudflare_api_token_here
R2_BUCKET=phoss-lab
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
